# DataIQ — Environment Config Template
# Copy this file to '.env' and insert your OpenAI API key below.

# -----------------------------------------------------------------------------
# OpenAI API Credentials
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-api-key-here

# Preferred Model Selection:
# - gpt-4o      : Recommended for maximum code accuracy and complex data analysis
# - gpt-4o-mini : Fast (~1s), low-cost alternative for standard queries
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Local Ollama Backend Config (Optional)
# -----------------------------------------------------------------------------
# OLLAMA_MODEL=llama3
